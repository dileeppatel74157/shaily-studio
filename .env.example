# ==============================================================================
# SHAILY STUDIO PERSONAL AI OS CONFIGURATION TEMPLATE
# ==============================================================================
# Purpose: Template environment variables for local/production setup.
# Instructions: Copy this file to '.env' and fill in the values.
# Do NOT check your private '.env' file into source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Purpose: Set the runtime mode for NodeJS and Python backends.
# Required/Optional: Required.
# Default: development.
# Obtain from: N/A.
NODE_ENV=development
PYTHON_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE & PERSISTENCE CONFIGURATION
# ------------------------------------------------------------------------------
# Purpose: Connection string for PostgreSQL/Supabase database.
# Required/Optional: Required.
# Default: postgresql://shaily_admin:shaily_secure_password_123@localhost:5432/shaily_studio_dev
# Obtain from: Supabase Settings -> Database connection info, or local PG instance.
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/your_db_name

# Purpose: Direct database connection URL (bypassing connection poolers like PgBouncer).
# Required/Optional: Optional.
# Default: N/A.
# Obtain from: Supabase Settings -> Database connection info.
DIRECT_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/your_db_name

# Purpose: Base URL of your Supabase API project.
# Required/Optional: Optional (Required if using Supabase client directly).
# Default: N/A.
# Obtain from: Supabase Project Settings -> API.
SUPABASE_URL=https://your-project-id.supabase.co

# Purpose: Supabase anonymous API key for public access.
# Required/Optional: Optional.
# Default: N/A.
# Obtain from: Supabase Project Settings -> API.
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Purpose: Supabase service role API key (bypasses Row Level Security).
# Required/Optional: Optional (Use only in server environments).
# Default: N/A.
# Obtain from: Supabase Project Settings -> API.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 3. AI PROVIDERS CONFIGURATION
# ------------------------------------------------------------------------------
# -- Provider Fallback Routing --
PRIMARY_PROVIDER=gemini
FALLBACK_PROVIDERS=nvidia,openai,ollama

# -- Google Gemini --
# Purpose: API key for Google Gemini model access.
# Required/Optional: Required (if using Gemini).
# Default: N/A.
# Obtain from: Google AI Studio (https://aistudio.google.com/).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com

# -- OpenAI --
# Purpose: API key for OpenAI GPT-4o model access.
# Required/Optional: Required (if using OpenAI).
# Default: N/A.
# Obtain from: OpenAI Platform API Keys (https://platform.openai.com/).
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# -- Anthropic Claude --
# Purpose: API key for Anthropic Claude model access.
# Required/Optional: Required (if using Claude).
# Default: N/A.
# Obtain from: Anthropic Console API Keys (https://console.anthropic.com/).
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL_NAME=claude-3-5-sonnet

# -- Grok (xAI) --
# Purpose: API key for Grok model access.
# Required/Optional: Required (if using Grok).
# Default: N/A.
# Obtain from: xAI Console API Keys (https://console.x.ai/).
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL_NAME=grok-2

# -- Ollama (Local) --
# Purpose: Local endpoint URL for Ollama service.
# Required/Optional: Optional (Required if running models locally).
# Default: http://localhost:11434
# Obtain from: Local Ollama instance setup.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3

# ------------------------------------------------------------------------------
# 4. MEDIA GENERATION CONFIGURATION
# ------------------------------------------------------------------------------
# -- Media Routing Configuration --
IMAGE_PRIMARY_PROVIDER=gemini
IMAGE_FALLBACK_PROVIDERS=nvidia,openai
IMAGE_PROVIDER_MODEL=gemini-2.5-flash-image-preview

VIDEO_PRIMARY_PROVIDER=gemini
VIDEO_FALLBACK_PROVIDERS=
VIDEO_PROVIDER_MODEL=veo-3
VIDEO_OUTPUT_FORMAT=mp4
VIDEO_DEFAULT_DURATION=8
VIDEO_DEFAULT_ASPECT_RATIO=16:9

# -- Image Provider (e.g., Midjourney, DALL-E) --
# Purpose: API key for generating AI visuals/thumbnails.
# Required/Optional: Required.
# Default: N/A.
IMAGE_PROVIDER_API_KEY=your_image_provider_key_here
IMAGE_PROVIDER_MODEL=dall-e-3
IMAGE_PROVIDER_BASE_URL=https://api.openai.com/v1

# -- Video Provider (e.g., Runway, Sora) --
# Purpose: API key for generating AI video clips.
# Required/Optional: Optional.
# Default: N/A.
VIDEO_PROVIDER_API_KEY=your_video_provider_key_here
VIDEO_PROVIDER_MODEL=runway-gen3

# -- Voice Provider (e.g., ElevenLabs) --
# Purpose: API key for generating AI narrations.
# Required/Optional: Required.
# Default: N/A.
# Obtain from: ElevenLabs Dashboard.
VOICE_PROVIDER_API_KEY=your_voice_provider_key_here
VOICE_PROVIDER_MODEL=eleven_monolingual_v1

# -- Thumbnail Provider (e.g., Ideogram) --
# Purpose: API key for generating high-quality custom thumbnail graphics.
# Required/Optional: Optional.
# Default: N/A.
THUMBNAIL_PROVIDER_API_KEY=your_thumbnail_provider_key_here
THUMBNAIL_PROVIDER_MODEL=ideogram-v1

# ==========================================================
# STORAGE
# ==========================================================

STORAGE_PROVIDER=local

LOCAL_STORAGE_PATH=./storage

STORAGE_BUCKET_IMAGES=images
STORAGE_BUCKET_VIDEOS=videos
STORAGE_BUCKET_AUDIO=audio
STORAGE_BUCKET_EXPORTS=exports
STORAGE_BUCKET_THUMBNAILS=thumbnails
STORAGE_BUCKET_TEMP=temp
STORAGE_BUCKET_CACHE=cache

# Purpose: AWS Access Key for S3-compatible cloud storage.
# Required/Optional: Optional (Required if STORAGE_PROVIDER=s3).
# Default: N/A.
STORAGE_ACCESS_KEY=your_storage_access_key

# Purpose: AWS Secret Key for S3-compatible cloud storage.
# Required/Optional: Optional (Required if STORAGE_PROVIDER=s3).
# Default: N/A.
STORAGE_SECRET_KEY=your_storage_secret_key

# Purpose: AWS/S3 Region for cloud bucket endpoint.
# Required/Optional: Optional (Required if STORAGE_PROVIDER=s3).
# Default: us-east-1.
STORAGE_REGION=us-east-1

# ------------------------------------------------------------------------------
# 6. PUBLISHING & YOUTUBE INTEGRATION
# ------------------------------------------------------------------------------
# Purpose: YouTube Developer Data API key.
# Required/Optional: Required.
# Default: N/A.
# Obtain from: Google Cloud Console -> Enabled APIs -> YouTube Data API v3.
YOUTUBE_API_KEY=your_youtube_api_key_here

# Purpose: Client OAuth credentials for personal YouTube upload authentication.
# Required/Optional: Required.
# Default: N/A.
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials.
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here

# Purpose: YouTube Channel ID of the owner.
# Required/Optional: Required.
# Default: N/A.
# Obtain from: YouTube Account Advanced Settings.
YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here
