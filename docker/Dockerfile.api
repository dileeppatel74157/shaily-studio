# syntax=docker/dockerfile:1

# ─── Stage 1: Base Runtime ────────────────────────────────────────────────────
FROM node:22-alpine AS base

# Install curl/wget for healthchecks
RUN apk add --no-cache curl wget ffmpeg

WORKDIR /app

# Install pnpm globally
RUN npm install -g pnpm@11.9.0

# ─── Stage 2: Builder ─────────────────────────────────────────────────────────
FROM base AS builder

WORKDIR /app

# Copy root configurations and workspace files
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/config ./packages/config
COPY packages/shared ./packages/shared
COPY packages/core ./packages/core
COPY apps/api ./apps/api

# Install dependencies and build
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @shaily/shared build
RUN pnpm --filter @shaily/core build
RUN pnpm --filter api build

# ─── Stage 3: Development Target ──────────────────────────────────────────────
FROM builder AS development

WORKDIR /app/apps/api

EXPOSE 8000
CMD ["pnpm", "dev"]

# ─── Stage 4: Production Target ───────────────────────────────────────────────
FROM base AS production

WORKDIR /app

# Copy built code from builder
COPY --from=builder /app /app

WORKDIR /app/apps/api

EXPOSE 8000
CMD ["node", "dist/index.js"]
